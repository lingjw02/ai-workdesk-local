# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file anywhere public.

# -----------------------------------------------------------------------------
# Cloud LLM Provider: OpenRouter (https://openrouter.ai/keys)
# -----------------------------------------------------------------------------
# Required if using OpenRouter models
OPENROUTER_API_KEY=

# Optional — sent to OpenRouter for app identification
APP_URL=http://localhost:3787
APP_NAME=AI WorkDesk OS

# Model IDs ("provider/model" slugs, browse at https://openrouter.ai/models)
INSTANT_MODEL=openai/gpt-4o-mini
EXPERT_MODEL=anthropic/claude-sonnet-4.5
WORKER_MODEL=anthropic/claude-sonnet-4.5

# -----------------------------------------------------------------------------
# Local LLM Provider: Ollama / LM Studio / LocalAI (OpenAI-compatible)
# -----------------------------------------------------------------------------
# Optional — enables local-first privacy routing for sensitive tasks
# e.g., http://localhost:11434/v1 for Ollama, http://localhost:1234/v1 for LM Studio
LOCAL_ENDPOINT=
LOCAL_MODEL=

# -----------------------------------------------------------------------------
# Free Relay: ChatAnywhere (https://chatanywhere.tech)
# -----------------------------------------------------------------------------
# Optional — free GPT relay (register & bind GitHub for a free key)
# Endpoint: https://api.chatanywhere.tech/v1 (CN) or https://api.chatanywhere.org/v1 (Global)
CHATANYWHERE_API_KEY=
CHATANYWHERE_ENDPOINT=https://api.chatanywhere.tech/v1
CHATANYWHERE_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Web Search: Brave Search API (https://brave.com/search/api/)
# -----------------------------------------------------------------------------
# Optional — enables real web search for chat and Researcher worker.
# If left blank, keyless Bing search fallback is used.
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3787
